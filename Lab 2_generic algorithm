        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import random\n",
        "\n",
        "# ==========================================\n",
        "# 1. PROBLEM PARAMETERS\n",
        "# ==========================================\n",
        "\n",
        "NUM_JOBS = 20\n",
        "NUM_MACHINES = 4\n",
        "POPULATION_SIZE = 50\n",
        "GENERATIONS = 100\n",
        "MUTATION_RATE = 0.1\n",
        "CROSSOVER_RATE = 0.8\n",
        "\n",
        "random.seed(42)\n",
        "np.random.seed(42)\n",
        "\n",
        "# Processing time of each job\n",
        "processing_times = np.random.randint(\n",
        "    2, 20, size=NUM_JOBS\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# 2. SCHEDULE EVALUATION\n",
        "# ==========================================\n",
        "\n",
        "def evaluate_schedule(schedule):\n",
        "\n",
        "    machine_times = np.zeros(NUM_MACHINES)\n",
        "\n",
        "    for job in schedule:\n",
        "\n",
        "        machine = np.argmin(machine_times)\n",
        "\n",
        "        machine_times[machine] += processing_times[job]\n",
        "\n",
        "    makespan = np.max(machine_times)\n",
        "\n",
        "    return makespan\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 3. INITIAL POPULATION\n",
        "# ==========================================\n",
        "\n",
        "def generate_population():\n",
        "\n",
        "    population = []\n",
        "\n",
        "    for _ in range(POPULATION_SIZE):\n",
        "\n",
        "        schedule = list(range(NUM_JOBS))\n",
        "        random.shuffle(schedule)\n",
        "\n",
        "        population.append(schedule)\n",
        "\n",
        "    return population\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 4. FITNESS FUNCTION\n",
        "# ==========================================\n",
        "\n",
        "def fitness(schedule):\n",
        "\n",
        "    return 1 / (1 + evaluate_schedule(schedule))\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 5. SELECTION\n",
        "# ==========================================\n",
        "\n",
        "def selection(population):\n",
        "\n",
        "    selected = random.sample(\n",
        "        population, 3\n",
        "    )\n",
        "\n",
        "    selected.sort(\n",
        "        key=evaluate_schedule\n",
        "    )\n",
        "\n",
        "    return selected[0]\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 6. CROSSOVER\n",
        "# ==========================================\n",
        "\n",
        "def crossover(parent1, parent2):\n",
        "\n",
        "    if random.random() > CROSSOVER_RATE:\n",
        "        return parent1.copy()\n",
        "\n",
        "    start, end = sorted(\n",
        "        random.sample(range(NUM_JOBS), 2)\n",
        "    )\n",
        "\n",
        "    child = [-1] * NUM_JOBS\n",
        "\n",
        "    child[start:end] = parent1[start:end]\n",
        "\n",
        "    remaining = [\n",
        "        job for job in parent2\n",
        "        if job not in child\n",
        "    ]\n",
        "\n",
        "    index = 0\n",
        "\n",
        "    for i in range(NUM_JOBS):\n",
        "\n",
        "        if child[i] == -1:\n",
        "\n",
        "            child[i] = remaining[index]\n",
        "            index += 1\n",
        "\n",
        "    return child\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 7. MUTATION\n",
        "# ==========================================\n",
        "\n",
        "def mutation(schedule):\n",
        "\n",
        "    schedule = schedule.copy()\n",
        "\n",
        "    if random.random() < MUTATION_RATE:\n",
        "\n",
        "        i, j = random.sample(\n",
        "            range(NUM_JOBS), 2\n",
        "        )\n",
        "\n",
        "        schedule[i], schedule[j] = (\n",
        "            schedule[j], schedule[i]\n",
        "        )\n",
        "\n",
        "    return schedule\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 8. GENETIC OPTIMIZATION\n",
        "# ==========================================\n",
        "\n",
        "population = generate_population()\n",
        "\n",
        "best_schedule = None\n",
        "best_makespan = float('inf')\n",
        "\n",
        "convergence = []\n",
        "\n",
        "for generation in range(GENERATIONS):\n",
        "\n",
        "    population.sort(\n",
        "        key=evaluate_schedule\n",
        "    )\n",
        "\n",
        "    current_best = population[0]\n",
        "    current_makespan = evaluate_schedule(\n",
        "        current_best\n",
        "    )\n",
        "\n",
        "    if current_makespan < best_makespan:\n",
        "\n",
        "        best_makespan = current_makespan\n",
        "        best_schedule = current_best.copy()\n",
        "\n",
        "    convergence.append(best_makespan)\n",
        "\n",
        "    # Elitism\n",
        "    new_population = population[:2]\n",
        "\n",
        "    while len(new_population) < POPULATION_SIZE:\n",
        "\n",
        "        parent1 = selection(population)\n",
        "        parent2 = selection(population)\n",
        "\n",
        "        child = crossover(parent1, parent2)\n",
        "\n",
        "        child = mutation(child)\n",
        "\n",
        "        new_population.append(child)\n",
        "\n",
        "    population = new_population\n",
        "\n",
        "# ==========================================\n",
        "# 9. DISPLAY RESULTS\n",
        "# ==========================================\n",
        "\n",
        "print(\"OPTIMIZATION RESULTS\")\n",
        "print(\"-----------------------------\")\n",
        "\n",
        "print(\"Number of Jobs:\", NUM_JOBS)\n",
        "print(\"Number of Machines:\", NUM_MACHINES)\n",
        "\n",
        "print(\"Best Schedule:\", best_schedule)\n",
        "\n",
        "print(\"Minimum Makespan:\", best_makespan)\n",
        "\n",
        "# ==========================================\n",
        "# 10. MACHINE ALLOCATION\n",
        "# ==========================================\n",
        "\n",
        "machine_times = np.zeros(NUM_MACHINES)\n",
        "\n",
        "allocation = []\n",
        "\n",
        "for job in best_schedule:\n",
        "\n",
        "    machine = np.argmin(machine_times)\n",
        "\n",
        "    start_time = machine_times[machine]\n",
        "\n",
        "    finish_time = (\n",
        "        start_time + processing_times[job]\n",
        "    )\n",
        "\n",
        "    allocation.append({\n",
        "        \"Job\": job + 1,\n",
        "        \"Machine\": machine + 1,\n",
        "        \"Processing Time\": processing_times[job],\n",
        "        \"Start Time\": start_time,\n",
        "        \"Finish Time\": finish_time\n",
        "    })\n",
        "\n",
        "    machine_times[machine] = finish_time\n",
        "\n",
        "results = pd.DataFrame(allocation)\n",
        "\n",
        "print(\"\\nJOB SCHEDULING TABLE\")\n",
        "display(results)\n",
        "\n",
        "# ==========================================\n",
        "# 11. CONVERGENCE GRAPH\n",
        "# ==========================================\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.plot(\n",
        "    convergence,\n",
        "    color='blue',\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "plt.title(\"Genetic Algorithm Convergence\")\n",
        "plt.xlabel(\"Generation\")\n",
        "plt.ylabel(\"Best Makespan\")\n",
        "\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# ==========================================\n",
        "# 12. MACHINE UTILIZATION\n",
        "# ==========================================\n",
        "\n",
        "utilization = (\n",
        "    machine_times / best_makespan\n",
        ") * 100\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.bar(\n",
        "    range(1, NUM_MACHINES + 1),\n",
        "    utilization,\n",
        "    color='green'\n",
        ")\n",
        "\n",
        "plt.title(\"Machine Utilization\")\n",
        "plt.xlabel(\"Machine\")\n",
        "plt.ylabel(\"Utilization (%)\")\n",
        "\n",
        "plt.xticks(\n",
        "    range(1, NUM_MACHINES + 1)\n",
        ")\n",
        "\n",
        "plt.ylim(0, 110)\n",
        "plt.grid(axis='y')\n",
        "\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nMachine Utilization:\")\n",
        "\n",
        "for i, value in enumerate(utilization):\n",
        "\n",
        "    print(\n",
        "        f\"Machine {i+1}: {value:.2f}%\"\n",
        "    )\n"
