        "\n",
        "import numpy as np\n",
        "from scipy.special import gamma\n",
        "\n",
        "# Cuckoo Search Algorithm\n",
        "class CuckooSearch:\n",
        "\n",
        "    def __init__(self, objective, dim=10,\n",
        "                 n=25, pa=0.25,\n",
        "                 alpha=1.0, iterations=100):\n",
        "\n",
        "        self.objective = objective\n",
        "        self.dim = dim\n",
        "        self.n = n\n",
        "        self.pa = pa\n",
        "        self.alpha = alpha\n",
        "        self.iterations = iterations\n",
        "\n",
        "        self.lower = -5.12\n",
        "        self.upper = 5.12\n",
        "\n",
        "    # Generate Levy flight steps using Mantegna's method\n",
        "    def levy_flight(self, size, beta=1.5):\n",
        "\n",
        "        sigma = (\n",
        "            gamma(1 + beta) *\n",
        "            np.sin(np.pi * beta / 2) /\n",
        "            (gamma((1 + beta) / 2) *\n",
        "             beta * 2 ** ((beta - 1) / 2))\n",
        "        ) ** (1 / beta)\n",
        "\n",
        "        u = np.random.normal(0, sigma, size)\n",
        "        v = np.random.normal(0, 1, size)\n",
        "\n",
        "        step = u / (np.abs(v) ** (1 / beta))\n",
        "\n",
        "        return step\n",
        "\n",
        "    # Main optimization\n",
        "    def optimize(self):\n",
        "\n",
        "        nests = np.random.uniform(\n",
        "            self.lower, self.upper,\n",
        "            (self.n, self.dim)\n",
        "        )\n",
        "\n",
        "        fitness = np.array([\n",
        "            self.objective(x) for x in nests\n",
        "        ])\n",
        "\n",
        "        best_index = np.argmin(fitness)\n",
        "        best_solution = nests[best_index].copy()\n",
        "        best_fitness = fitness[best_index]\n",
        "\n",
        "        history = []\n",
        "\n",
        "        for iteration in range(self.iterations):\n",
        "\n",
        "            # Generate a new cuckoo solution\n",
        "            for i in range(self.n):\n",
        "\n",
        "                step = self.levy_flight(self.dim)\n",
        "\n",
        "                new_solution = (\n",
        "                    nests[i] +\n",
        "                    self.alpha * step * (\n",
        "                        nests[i] - best_solution\n",
        "                    )\n",
        "                )\n",
        "\n",
        "                new_solution = np.clip(\n",
        "                    new_solution,\n",
        "                    self.lower,\n",
        "                    self.upper\n",
        "                )\n",
        "\n",
        "                new_fitness = self.objective(new_solution)\n",
        "\n",
        "                # Randomly select a nest\n",
        "                j = np.random.randint(self.n)\n",
        "\n",
        "                if new_fitness < fitness[j]:\n",
        "\n",
        "                    nests[j] = new_solution\n",
        "                    fitness[j] = new_fitness\n",
        "\n",
        "            # Abandon a fraction of worse nests\n",
        "            abandon = np.random.rand(\n",
        "                self.n, self.dim\n",
        "            ) < self.pa\n",
        "\n",
        "            random_steps = np.random.uniform(\n",
        "                self.lower, self.upper,\n",
        "                (self.n, self.dim)\n",
        "            )\n",
        "\n",
        "            nests = np.where(\n",
        "                abandon, random_steps, nests\n",
        "            )\n",
        "\n",
        "            fitness = np.array([\n",
        "                self.objective(x) for x in nests\n",
        "            ])\n",
        "\n",
        "            # Update best solution\n",
        "            best_index = np.argmin(fitness)\n",
        "\n",
        "            if fitness[best_index] < best_fitness:\n",
        "\n",
        "                best_fitness = fitness[best_index]\n",
        "                best_solution = nests[\n",
        "                    best_index\n",
        "                ].copy()\n",
        "\n",
        "            history.append(best_fitness)\n",
        "\n",
        "            print(\n",
        "                f\"Iteration {iteration + 1}: \"\n",
        "                f\"Best Fitness = {best_fitness:.8f}\"\n",
        "            )\n",
        "\n",
        "        return best_solution, best_fitness, history\n",
        "\n",
        "\n",
        "# Benchmark function: Sphere function\n",
        "def sphere(x):\n",
        "    return np.sum(x ** 2)\n",
        "\n",
        "\n",
        "# Run the algorithm\n",
        "cs = CuckooSearch(\n",
        "    objective=sphere,\n",
        "    dim=10,\n",
        "    n=25,\n",
        "    pa=0.25,\n",
        "    iterations=100\n",
        ")\n",
        "\n",
        "best_solution, best_fitness, history = cs.optimize()\n",
        "\n",
        "print(\"\\nBest Solution:\", best_solution)\n",
        "print(\"Best Fitness:\", best_fitness)\n",
        "\n",
        "# Plot convergence\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.plot(history)\n",
        "plt.xlabel(\"Iterations\")\n",
        "plt.ylabel(\"Best Fitness\")\n",
        "plt.title(\"Cuckoo Search Convergence\")\n",
        "plt.grid()\n",
        "plt.show()\n"
